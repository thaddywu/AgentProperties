        "Record",
        "Data"
      ],
      "meaning": "Confirmed tool record mapped to a version-specific runtime data handle.",
      "key": [
        "Kind",
        "Record"
      ]
    },
    "JobState": {
      "kind": "derived",
      "args": [
        "State"
      ],
      "meaning": "States admitted by the job machine."
    },
    "ActiveRun": {
      "kind": "derived",
      "args": [
        "Run"
      ],
      "meaning": "A node currently refers to this run."
    },
    "KnownRun": {
      "kind": "derived",
      "args": [
        "Run"
      ],
      "meaning": "Run exists in the EDB."
    },
    "ValidAllocation": {
      "kind": "derived",
      "args": [
        "Job",
        "Run"
      ],
      "meaning": "Current job, run and node share the same allocation token."
    },
    "AllocationViolation": {
      "kind": "derived",
      "args": [
        "Resource"
      ],
      "meaning": "Must remain empty before and after protected operations."
    },
    "JobOutcome": {
      "kind": "input",
      "args": [
        "Job",
        "Reason"
      ],
      "meaning": "Latest confirmed business outcome of this job.",
      "key": [
        "Job"
      ]
    },
    "StopReason": {
      "kind": "input",
      "args": [
        "Job",
        "Reason"
      ],
      "meaning": "Confirmed stop reason retained as a fact.",
      "key": [
        "Job"
      ]
    }
  },
  "decision": {
    "request": "Request",
