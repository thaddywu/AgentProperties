        "Actor"
      ],
      "meaning": "A principal may use the ordinary user observation tools."
    },
    "Readable": {
      "kind": "derived",
      "args": [
        "Actor",
        "Job"
      ],
      "meaning": "The principal may read this stored job."
    },
    "PrivateReadable": {
