{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "policy:translate": "node scripts/repository-command.mjs tsx translation/src/cli.ts",
    "policy:review": "pnpm --filter @rakazo/web exec vite --config vite.nova.config.ts",
    "dev": "pnpm --parallel --filter @rakazo/api --filter @rakazo/worker --filter @rakazo/web --filter @rakazo/sandbox-supervisor run dev",
    "build": "pnpm db:generate && pnpm --recursive --if-present run build",
    "check": "pnpm db:generate && pnpm --recursive --if-present run check",
    "lint": "biome check . && pnpm --recursive --filter @rakazo/nova --filter @rakazo/document-vault --filter @rakazo/policy-runtime --filter @rakazo/policy-translation run lint",
    "format": "biome check --write . && pnpm --recursive --filter @rakazo/nova --filter @rakazo/document-vault --filter @rakazo/policy-runtime --filter @rakazo/policy-translation run format",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/db migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "test": "vitest run --config config/vitest.config.ts",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @rakazo/db generate && node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/mobile-screenshots.ts",
    "test:topology": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/topology.ts",
    "test:canary": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run --config config/vitest.config.ts grokbot/packages/testkit/src/model-emulator.test.ts grokbot/packages/testkit/src/pi-offline.test.ts",
    "test:evals": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/evals.ts",
    "test:computer-replay": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/computer.ts",
    "perf:desktop": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "node scripts/repository-command.mjs tsx grokbot/packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file ../.env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file ../.env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    }
  }
}
