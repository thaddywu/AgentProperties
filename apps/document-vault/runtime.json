{
  "version": 1,
  "id": "document-vault",
  "context": "The trusted service owns Public(Document), Confidential(Document), Reader(Actor, Document), Role(Actor, RoleName), Suspended(Actor) and Read(Actor, Document). Role name reviewer is the review qualification. Public and Confidential mark known documents. A read request has Action equal to read; other actions are unsupported. Accessible is a read-only policy result about current authorization. Read is an observation committed by the application after a successful callback; policy rules cannot create it. This is a single service session, with no distributed stores, message transport protocol. The adapter authenticates the actor before calling execute; Markdown does not grant roles or permissions. Actor(Actor) lists known authenticated accounts; only these accounts can be permitted or Accessible.",
  "predicates": {
    "Actor": {
      "kind": "input",
      "args": ["Actor"],
      "meaning": "Known authenticated account, supplied by the service."
    },
    "Public": {
      "kind": "input",
      "args": ["Document"],
      "meaning": "Known public document."
    },
    "Confidential": {
      "kind": "input",
      "args": ["Document"],
      "meaning": "Known confidential document."
    },
    "Reader": {
      "kind": "input",
      "args": ["Actor", "Document"],
      "meaning": "Trusted explicit reader grant."
    },
    "Role": {
      "kind": "input",
      "args": ["Actor", "RoleName"],
      "meaning": "Trusted current role; reviewer is the review role."
    },
    "Suspended": {
      "kind": "input",
      "args": ["Actor"],
      "meaning": "Trusted suspension; overrides permissions."
    },
    "Read": {
      "kind": "input",
      "args": ["Actor", "Document"],
      "meaning": "Actual successful read recorded by the service after callback success."
    },
    "Request": {
      "kind": "input",
      "args": ["RequestId", "Actor", "Action", "Resource"],
      "meaning": "Transient gate request created only by the runtime."
    },
    "Allow": {
      "kind": "derived",
      "args": ["RequestId"],
      "meaning": "Explicit permission for this request, subject to denial override."
    },
    "Deny": {
      "kind": "derived",
      "args": ["RequestId", "Reason"],
      "meaning": "Explicit refusal. Any reason overrides Allow."
    },
    "Accessible": {
      "kind": "derived",
      "args": ["Actor", "Document"],
      "meaning": "This actor could read this known document now, under all policy conditions."
    }
  },
  "decision": {
    "request": "Request",
    "allow": "Allow",
    "deny": "Deny"
  },
  "tests": [
    {
      "name": "public-read",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        },
        {
          "predicate": "Public",
          "args": ["guide"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "read",
        "resource": "guide"
      },
      "allowed": true
    },
    {
      "name": "qualified-reader",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["reviewer-a"]
        },
        {
          "predicate": "Confidential",
          "args": ["draft"]
        },
        {
          "predicate": "Reader",
          "args": ["reviewer-a", "draft"]
        },
        {
          "predicate": "Role",
          "args": ["reviewer-a", "reviewer"]
        }
      ],
      "request": {
        "actor": "reviewer-a",
        "action": "read",
        "resource": "draft"
      },
      "allowed": true
    },
    {
      "name": "reader-without-role",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        },
        {
          "predicate": "Confidential",
          "args": ["draft"]
        },
        {
          "predicate": "Reader",
          "args": ["visitor", "draft"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "read",
        "resource": "draft"
      },
      "allowed": false
    },
    {
      "name": "role-without-grant",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        },
        {
          "predicate": "Confidential",
          "args": ["draft"]
        },
        {
          "predicate": "Role",
          "args": ["visitor", "reviewer"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "read",
        "resource": "draft"
      },
      "allowed": false
    },
    {
      "name": "suspended-public-reader",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        },
        {
          "predicate": "Public",
          "args": ["guide"]
        },
        {
          "predicate": "Suspended",
          "args": ["visitor"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "read",
        "resource": "guide"
      },
      "allowed": false
    },
    {
      "name": "suspended-qualified-reader",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["reviewer-a"]
        },
        {
          "predicate": "Confidential",
          "args": ["draft"]
        },
        {
          "predicate": "Reader",
          "args": ["reviewer-a", "draft"]
        },
        {
          "predicate": "Role",
          "args": ["reviewer-a", "reviewer"]
        },
        {
          "predicate": "Suspended",
          "args": ["reviewer-a"]
        }
      ],
      "request": {
        "actor": "reviewer-a",
        "action": "read",
        "resource": "draft"
      },
      "allowed": false
    },
    {
      "name": "unknown-document",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "read",
        "resource": "missing"
      },
      "allowed": false
    },
    {
      "name": "unsupported-action",
      "inputs": [
        {
          "predicate": "Actor",
          "args": ["visitor"]
        },
        {
          "predicate": "Public",
          "args": ["guide"]
        }
      ],
      "request": {
        "actor": "visitor",
        "action": "delete",
        "resource": "guide"
      },
      "allowed": false
    }
  ]
}
