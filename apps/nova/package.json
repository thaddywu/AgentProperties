{
  "name": "@rakazo/nova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./worker-path": "./src/worker-path.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../../grokbot test apps/nova/tests",
