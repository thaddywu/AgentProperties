    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@rakazo/policy-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "tsx": "4.23.13",
    "@biomejs/biome": "2.5.13"
  }
}
